### AL ###
# Template for AL projects for Dynamics 365 Business Central
# Shared VS Code project settings; keep personal files ignored.
.vscode/*
!.vscode/c_cpp_properties.json
!.vscode/settings.json
# Cache folder
.alcache/
# Symbols folder
.alpackages/
# Snapshots folder
.snapshots/
# Testing output folder
.output/
# Extension app file
*.app
# Rapid Application Development file
rad.json
# Translation base file
*.g.xlf
# License files
*.bclicense
*.flf
# Test results file
TestResults.xml

# Shared LibTorch installation and downloaded archives
/libtorch/
/libtorch-*.zip
/libtorch-*-old/

# Top-level CMake build
/build/
